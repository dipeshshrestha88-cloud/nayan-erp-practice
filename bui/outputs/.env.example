# Never commit a real .env file. Set these in the deployment platform's secret manager.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Required for the production service. Use a managed PostgreSQL connection string.
DATABASE_URL=postgres://nayan_app:replace-me@db.example.com:5432/nayan_erp
DATABASE_SSL=true
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret

# Cloud object storage (S3, Cloudflare R2, MinIO or a compatible provider).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=nayan-erp-documents
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Development-only compatibility mode for the original prototype.
LOCAL_DATA_FILE=./data/nirmaan-db.json
